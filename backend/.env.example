NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb+srv://...

# Redis (Upstash) — optional for now
REDIS_URL=

# JWT
JWT_SECRET=replace_me_with_long_random_string
JWT_EXPIRES_IN=7d

# Squad
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_SECRET_KEY=sandbox_sk_xxx
SQUAD_PUBLIC_KEY=sandbox_pk_xxx
SQUAD_BENEFICIARY_ACCOUNT=
SQUAD_MERCHANT_ID=

# Admin (header X-Admin-Key on /admin routes for demo)
ADMIN_KEY=some_static_admin_key_for_demo

# Twilio (optional — SMS silently skipped if missing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App
API_BASE_URL=http://localhost:4000
