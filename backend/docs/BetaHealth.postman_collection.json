{
  "info": {
    "name": "BetaHealth API",
    "_postman_id": "betahealth-collection-v1",
    "description": "Micro health cover for Nigeria's informal sector. All money in kobo (₦1 = 100 kobo).\n\nThree auth schemes:\n- `{{jwt}}` — Bearer token from /auth/login or /auth/login/verify-otp\n- `{{hospitalApiKey}}` — header `x-hospital-api-key`, from POST /hospital/register\n- `{{adminKey}}` — header `x-admin-key`, from .env ADMIN_KEY\n\nSet collection variables under the **Variables** tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "jwt", "value": "" },
    { "key": "hospitalApiKey", "value": "" },
    { "key": "adminKey", "value": "local_dev_admin_key_change_me" },
    { "key": "userPhone", "value": "08099000010" },
    { "key": "userPassword", "value": "demo1234" },
    { "key": "userId", "value": "" },
    { "key": "hospitalId", "value": "" },
    { "key": "claimId", "value": "" },
    { "key": "preAuthCode", "value": "" },
    { "key": "faceToken", "value": "" },
    { "key": "otpCode", "value": "" },
    { "key": "membershipNumber", "value": "" },
    { "key": "resetCode", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@test.co\",\n  \"phone\": \"08012345678\",\n  \"password\": \"Str0ngP@ss\",\n  \"fullName\": \"Ada Lovelace\",\n  \"dob\": \"1995-04-12\",\n  \"bvn\": \"12345678901\",\n  \"occupation\": \"trader\",\n  \"gender\": \"female\",\n  \"address\": \"5 Test St, Lagos\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "POST /auth/login (password only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.data && r.data.token) {",
                  "  pm.collectionVariables.set('jwt', r.data.token);",
                  "  pm.collectionVariables.set('userId', r.data.user.id);",
                  "  console.log('JWT stored as {{jwt}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{userPhone}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "POST /auth/login/request-otp",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{userPhone}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/request-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login", "request-otp"]
            },
            "description": "Step 1 of two-step login. Sends a 6-digit OTP via SMS + in-app notification. Copy the code (from the SMS or from GET /notifications) and use it in step 2."
          }
        },
        {
          "name": "POST /auth/login/verify-otp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.data && r.data.token) {",
                  "  pm.collectionVariables.set('jwt', r.data.token);",
                  "  pm.collectionVariables.set('userId', r.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{userPhone}}\",\n  \"code\": \"{{otpCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login", "verify-otp"]
            }
          }
        },
        {
          "name": "POST /auth/forgot-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{userPhone}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            },
            "description": "Sends a 6-digit reset code (15-min expiry) via in-app + SMS + email. Response is generic — never reveals whether the account exists."
          }
        },
        {
          "name": "POST /auth/reset-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{userPhone}}\",\n  \"code\": \"{{resetCode}}\",\n  \"newPassword\": \"NewStr0ngP@ss\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "Set {{resetCode}} from the code that arrived in SMS/email/notification feed, then run."
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /users/me/wallet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/users/me/wallet", "host": ["{{baseUrl}}"], "path": ["users", "me", "wallet"] }
          }
        },
        {
          "name": "GET /users/me/card (lean — client renders QR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.data && r.data.membershipNumber) {",
                  "  pm.collectionVariables.set('membershipNumber', r.data.membershipNumber);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/users/me/card", "host": ["{{baseUrl}}"], "path": ["users", "me", "card"] },
            "description": "Default response: { membershipNumber, fullName, qrPayload }. The client renders the QR from qrPayload — React Native + every web framework has a QR component. Use the membership number for the future physical card and as a lookup key for hospitals scanning the QR."
          }
        },
        {
          "name": "GET /users/me/card?withImage=true (server-rendered PNG)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/me/card?withImage=true",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "card"],
              "query": [{ "key": "withImage", "value": "true" }]
            },
            "description": "Adds qrCodeDataUrl (base64 PNG, ~3-5KB). Use this when the client can't render a QR locally — emailing a card, printing without a client-side renderer."
          }
        },
        {
          "name": "GET /users/me/transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/me/transactions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET /users/me/claims",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/me/claims?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "claims"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET /users/me/withdrawable",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/me/withdrawable",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "withdrawable"]
            }
          }
        },
        {
          "name": "POST /users/me/withdraw",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 800000,\n  \"bankCode\": \"000013\",\n  \"accountNumber\": \"0123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "withdraw"]
            },
            "description": "Amount is in kobo. ₦8,000 = 800000."
          }
        },
        {
          "name": "POST /users/me/virtual-account/retry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/me/virtual-account/retry",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "virtual-account", "retry"]
            }
          }
        }
      ]
    },
