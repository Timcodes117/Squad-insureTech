    {
      "name": "Hospitals",
      "item": [
        {
          "name": "POST /hospital/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.data && r.data.apiKey) {",
                  "  pm.collectionVariables.set('hospitalApiKey', r.data.apiKey);",
                  "  pm.collectionVariables.set('hospitalId', r.data.hospital.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sunrise Clinic\",\n  \"contactPhone\": \"08012345677\",\n  \"email\": \"sunrise@test.co\",\n  \"address\": \"12 Health St, Lagos\",\n  \"bankCode\": \"000013\",\n  \"accountNumber\": \"0123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospital/register",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "register"]
            }
          }
        },
        {
          "name": "GET /hospital/users/lookup (by phone)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.data && r.data.preAuthCode) {",
                  "  pm.collectionVariables.set('preAuthCode', r.data.preAuthCode);",
                  "  if (r.data.membershipNumber) pm.collectionVariables.set('membershipNumber', r.data.membershipNumber);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-hospital-api-key", "value": "{{hospitalApiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/hospital/users/lookup?phone={{userPhone}}",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "users", "lookup"],
              "query": [{ "key": "phone", "value": "{{userPhone}}" }]
            }
          }
        },
        {
          "name": "GET /hospital/users/lookup (by membership / QR scan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.data && r.data.preAuthCode) {",
                  "  pm.collectionVariables.set('preAuthCode', r.data.preAuthCode);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-hospital-api-key", "value": "{{hospitalApiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/hospital/users/lookup?membership={{membershipNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "users", "lookup"],
              "query": [{ "key": "membership", "value": "{{membershipNumber}}" }]
            },
            "description": "Hospital scans the patient's card QR (BH-XXXXXXXXX) and looks them up. Same response as lookup-by-phone, including a fresh preAuth code."
          }
        },
        {
          "name": "POST /hospital/users/face-verify",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.data && r.data.faceVerificationToken) {",
                  "  pm.collectionVariables.set('faceToken', r.data.faceVerificationToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-hospital-api-key", "value": "{{hospitalApiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{userPhone}}\",\n  \"image\": \"data:image/jpeg;base64,FAKE_IMAGE_BYTES\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospital/users/face-verify",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "users", "face-verify"]
            },
            "description": "Dummy face verification — always returns verified=true. Issues a 10-minute single-use token that you can attach to the next /hospital/claims request."
          }
        },
        {
          "name": "POST /hospital/claims",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.success && r.data && r.data.claim) {",
                  "  pm.collectionVariables.set('claimId', r.data.claim.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-hospital-api-key", "value": "{{hospitalApiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{userPhone}}\",\n  \"amount\": 150000,\n  \"treatmentType\": \"malaria\",\n  \"clinicalNote\": \"Patient presented with fever, positive RDT\",\n  \"preAuthCode\": \"{{preAuthCode}}\",\n  \"faceVerificationToken\": \"{{faceToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospital/claims",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "claims"]
            },
            "description": "amount is in kobo (₦1,500 = 150000). faceVerificationToken is optional — leave blank if not running the face-verify step."
          }
        },
        {
          "name": "GET /hospital/claims",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-hospital-api-key", "value": "{{hospitalApiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/hospital/claims?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "claims"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "POST /webhooks/squad (manual — needs HMAC)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-squad-encrypted-body", "value": "<paste HMAC SHA-512 hex digest, UPPERCASE>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"virtual_account.credit\",\n  \"data\": {\n    \"transaction_reference\": \"SQUAD_TEST_001\",\n    \"virtual_account_number\": \"9988800030\",\n    \"settled_amount\": \"1000\",\n    \"principal_amount\": \"1000\",\n    \"currency_id\": \"NGN\",\n    \"transaction_date\": \"2026-05-15T07:00:00.000Z\",\n    \"sender_name\": \"JOHN PAYER\",\n    \"channel\": \"transfer\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/webhooks/squad", "host": ["{{baseUrl}}"], "path": ["webhooks", "squad"] },
            "description": "For easier local testing, use `node scripts/simulateWebhook.js --va 9988800030 --amount 1000` from the backend folder — it signs the body for you. If you do test it from Postman, generate the signature with: `HMAC_SHA512(SQUAD_SECRET_KEY, raw_body).hex().toUpperCase()`."
          }
        }
      ]
    },
